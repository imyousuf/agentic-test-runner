# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
.gemini/
.CodeEagle/
.CodeEagle.conf

# build output
bin/
atr

# Per-machine behavior test inputs. The committed *.test.properties holds the
# shared defaults; this is where one machine's differences go, so it must not
# be checked in. Note that gitignored is not the same as secret — credentials
# belong in a password manager, referenced by name via atr.fillSecret.
*.override.properties
# Live view web application
# web/dist is build output, not source. "make web" regenerates it and both CI
# workflows build it before compiling, so it is not committed.
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
